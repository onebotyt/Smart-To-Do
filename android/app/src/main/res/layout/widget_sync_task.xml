<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_background"
    android:padding="12dp">

    <!-- Header Row: Title & Bold Pending Counter -->
    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp"
        android:paddingHorizontal="4dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="SyncTask" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="To-dos"
            android:textColor="#94A3B8"
            android:textStyle="bold"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_pending_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="20sp" />
    </LinearLayout>

    <!-- Task Pill 1 -->
    <LinearLayout
        android:id="@+id/widget_task_row_1"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_below="@id/widget_header"
        android:background="@drawable/widget_pill_mint"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:layout_marginBottom="5dp">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/widget_radio_circle"
            android:contentDescription="Checkbox" />

        <TextView
            android:id="@+id/widget_task_text_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text=""
            android:textColor="#182026"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Task Pill 2 -->
    <LinearLayout
        android:id="@+id/widget_task_row_2"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_below="@id/widget_task_row_1"
        android:background="@drawable/widget_pill_amber"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:layout_marginBottom="5dp">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/widget_radio_circle"
            android:contentDescription="Checkbox" />

        <TextView
            android:id="@+id/widget_task_text_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text=""
            android:textColor="#182026"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Task Pill 3 -->
    <LinearLayout
        android:id="@+id/widget_task_row_3"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_below="@id/widget_task_row_2"
        android:background="@drawable/widget_pill_amber"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:layout_marginBottom="5dp">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/widget_radio_circle"
            android:contentDescription="Checkbox" />

        <TextView
            android:id="@+id/widget_task_text_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text=""
            android:textColor="#182026"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Task Pill 4 -->
    <LinearLayout
        android:id="@+id/widget_task_row_4"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_below="@id/widget_task_row_3"
        android:background="@drawable/widget_pill_blue"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:layout_marginBottom="5dp">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/widget_radio_circle"
            android:contentDescription="Checkbox" />

        <TextView
            android:id="@+id/widget_task_text_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text=""
            android:textColor="#182026"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Task Pill 5 -->
    <LinearLayout
        android:id="@+id/widget_task_row_5"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_below="@id/widget_task_row_4"
        android:background="@drawable/widget_pill_amber"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:layout_marginBottom="5dp">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/widget_radio_circle"
            android:contentDescription="Checkbox" />

        <TextView
            android:id="@+id/widget_task_text_5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text=""
            android:textColor="#182026"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Task Pill 6 -->
    <LinearLayout
        android:id="@+id/widget_task_row_6"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_below="@id/widget_task_row_5"
        android:background="@drawable/widget_pill_mint"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:layout_marginBottom="5dp">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/widget_radio_circle"
            android:contentDescription="Checkbox" />

        <TextView
            android:id="@+id/widget_task_text_6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text=""
            android:textColor="#182026"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Empty State -->
    <TextView
        android:id="@+id/widget_empty_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/widget_header"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:text="No pending tasks 🎉\nAll caught up!"
        android:textColor="#94A3B8"
        android:textSize="14sp"
        android:lineSpacingExtra="4dp"
        android:visibility="gone" />

    <!-- Bottom Action Row: (+) Add Task Button -->
    <ImageView
        android:id="@+id/widget_add_btn"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:src="@drawable/widget_ic_add"
        android:contentDescription="Add Task"
        android:padding="3dp" />

</RelativeLayout>
